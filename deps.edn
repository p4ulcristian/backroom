;; groundwork-background-jobs: background jobs on Postgres. A queue, workers and schedules.
;; One tree: source-code/groundwork_background_jobs/.
{:paths ["source-code"]

 :deps
 {;; Postgres: the queries and the table maps
  ;; on its tidy-up branch, not released: a table map writes out :uniques and :checks,
  ;; a reference what it does on delete, update and when checked, an index as a map;
  ;; migrate! takes {:tables :extensions :functions :views}; run-in-transaction! takes the
  ;; caller's :log, where work kept with run-after-commit! that fails is written
  io.github.p4ulcristian/groundwork-postgres  {:git/tag "v0.4.7" :git/sha "d6f226c"}
  ;; a background job's params, checked by its shape and kept as JSON text, by
  ;; the shaper the app makes and hands in
  io.github.p4ulcristian/groundwork-shaped-json    {:git/tag "v0.2.2" :git/sha "1c0fcf9"}
  ;; the app's log, handed in; each background job's run gets one that knows the job
  io.github.p4ulcristian/groundwork-logs {:git/tag "v0.1.3" :git/sha "8d1846e"}
  ;; the app's meter, handed in: jobs added, runs by outcome and time, jobs running
  io.github.p4ulcristian/groundwork-metrics   {:git/tag "v0.1.5" :git/sha "1cffe8e"}
  ;; the settings, options and kinds, checked before anything runs
  metosin/malli                 {:mvn/version "0.20.3"}}

 :aliases
 {;; the tests:  clojure -X:test  (the Postgres ones need BACKGROUND_JOBS_TEST_PORT, see README.md)
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
