;; backroom: background jobs on Postgres. A queue, workers and schedules.
;; One tree: source-code/backroom/.
{:paths ["source-code"]

 :deps
 {;; Postgres: the queries and the table maps
  io.github.p4ulcristian/cellar  {:git/tag "v0.4.0" :git/sha "62f32bd"}
  ;; a background job's params, checked by its shape and kept as JSON text, by
  ;; the wire the app makes and hands in
  io.github.p4ulcristian/wire    {:git/tag "v0.2.0" :git/sha "d66b7cb"}
  ;; the app's log, handed in; each background job's run gets one that knows the job
  io.github.p4ulcristian/logbook {:git/tag "v0.1.1" :git/sha "51a2c93"}
  ;; the app's meter, handed in: jobs added, runs by outcome and time, jobs running
  io.github.p4ulcristian/meter   {:git/tag "v0.1.2" :git/sha "a0a977b"}
  ;; the settings, options and kinds, checked before anything runs
  metosin/malli                 {:mvn/version "0.20.3"}}

 :aliases
 {;; the tests:  clojure -X:test  (the Postgres ones need BACKROOM_TEST_PORT, see README.md)
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
